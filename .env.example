# Groq API key (required). Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Speech-to-text model.
GROQ_WHISPER_MODEL=whisper-large-v3

# Text model used for summarization.
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_MB=200

# Groq's per-request audio size limit, in megabytes. Files larger than this
# are automatically split into chunks with FFmpeg before transcription.
GROQ_AUDIO_LIMIT_MB=25

# Approximate character budget for a single summarization request before
# the transcript is split into chunks.
MAX_CHARS_PER_CHUNK=12000
